// conf/test.config — fast smoke test with minimal resources
// Uses nf-core test-datasets or tiny subset of GSE52778

params {
    // Override samplesheet with 2-sample subset (1 treated, 1 control)
    input        = 'data/samplesheet_test.csv'
    outdir       = 'results_test'
    // Use a pre-built tiny index for human chr22 only
    salmon_index = 'data/test_index'
    tx2gene      = 'data/tx2gene_test.tsv'
    // Skip heavy enrichment in test mode
    skip_enrichment = true
}

process {
    withLabel: 'process_low' {
        cpus   = 1
        memory = '2.GB'
        time   = '30.m'
    }
    withLabel: 'process_medium' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }
    withLabel: 'process_high' {
        cpus   = 4
        memory = '8.GB'
        time   = '2.h'
    }
}
