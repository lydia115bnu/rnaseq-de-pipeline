// conf/slurm.config — SLURM executor settings for HPC clusters

executor {
    name            = 'slurm'
    queueSize       = 50        // max concurrent jobs
    submitRateLimit = '10/1min' // avoid flooding the scheduler
    pollInterval    = '30 sec'
}

process {
    executor       = 'slurm'
    queue          = 'normal'   // change to your partition name
    clusterOptions = '--account=YOUR_PROJECT_ACCOUNT'  // UPPMAX / Dardel / etc.

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
        queue  = 'core'
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = '32.GB'
        time   = '4.h'
    }
    withLabel: 'process_high' {
        cpus   = 16
        memory = '128.GB'
        time   = '12.h'
    }
}

// Singularity is the standard on HPC — no Docker
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${HOME}/.singularity/cache"
}
